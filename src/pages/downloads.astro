---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloadBtn from '../components/DownloadBtn.astro';
---

<BaseLayout title="FM27 Hub | Downloads">
  
  <h2 class="section-title">📥 Download-Center</h2>
  <p style="text-align: center; color: var(--text-secondary); margin-top: -1.5rem; margin-bottom: 2.5rem;">
    Praxiserprobte Taktiken (`.fmf`), Standard-Routinen, Trainingspläne und Medienpakete direkt zum Download.
  </p>

  <!-- TAKTIKEN SECTION -->
  <h3 style="color: var(--primary-color); border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
    📋 Taktik-Setups (.fmf)
  </h3>

  <div class="card-grid" style="margin-bottom: 3rem;">
    <!-- TAKTIK 1: 41131 - 41221 -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <span style="background: var(--primary-color); color: #fff; font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 4px; text-transform: uppercase;">
          FM27
        </span>
        <h3 style="color: var(--highlight-color); margin: 0.8rem 0 0.4rem 0;">4-1-1-3-1 / 4-1-2-2-1</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
          Dominantes Ballbesitzspiel mit hoher Kontrolle im Mittelfeld und flexibler Offensive.
        </p>
      </div>

      <DownloadBtn 
        file="tactics/xBurzelx_FM27_41131_-_41221.fmf" 
        label=".fmf Taktik herunterladen" 
        icon="📥"
      />
    </div>

    <!-- TAKTIK 2: 3421 - 541 -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <span style="background: var(--accent-color); color: #fff; font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 4px; text-transform: uppercase;">
          FM27
        </span>
        <h3 style="color: var(--highlight-color); margin: 0.8rem 0 0.4rem 0;">3-4-2-1 / 5-4-1</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
          Kompaktes Schienenspiel mit flexibler Fünferkette gegen umschaltstarke Gegner.
        </p>
      </div>

      <DownloadBtn 
        file="tactics/xBurzelx_FM27_3421_-_541.fmf" 
        label=".fmf Taktik herunterladen" 
        icon="📥"
      />
    </div>

    <!-- TAKTIK 3: 424 - 442 -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <span style="background: var(--highlight-color); color: #020202; font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 4px; text-transform: uppercase;">
          FM27
        </span>
        <h3 style="color: var(--highlight-color); margin: 0.8rem 0 0.4rem 0;">4-2-4 / 4-4-2</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
          Volle Offensive und maximaler Druck auf die gegnerische Kette für Aufholjagden.
        </p>
      </div>

      <DownloadBtn 
        file="tactics/xBurzelx_FM27_424_-_442.fmf" 
        label=".fmf Taktik herunterladen" 
        icon="📥"
      />
    </div>
  </div>

  <!-- STANDARDS SECTION -->
  <h3 style="color: var(--primary-color); border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
    🎯 Standardsituationen (Set-Pieces)
  </h3>

  <div class="card-grid" style="margin-bottom: 3rem;">
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <span style="background: var(--highlight-color); color: #020202; font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 4px; text-transform: uppercase;">
          FM27
        </span>
        <h3 style="color: var(--highlight-color); margin: 0.8rem 0 0.4rem 0;">🎯 Standard-Routinen Set</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
          Optimierte Ecken, Freistöße und Einwürfe (offensiv & defensiv). Perfekt zum Importieren in eigene Taktik-Setups.
        </p>
      </div>

      <DownloadBtn 
        file="set-pieces/xBurzelx_Standards.zip" 
        label=".zip Set herunterladen" 
        icon="📥"
      />
    </div>
  </div>

  <!-- TRAINING SECTION -->
  <h3 style="color: var(--primary-color); border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
    🏋️ Trainingspläne & Wochenroutinen
  </h3>

  <div class="card-grid" style="margin-bottom: 3rem;">
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <span style="background: var(--primary-color); color: #fff; font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 4px; text-transform: uppercase;">
          FM27
        </span>
        <h3 style="color: var(--highlight-color); margin: 0.8rem 0 0.4rem 0;">🏋️ xBurzelx Trainings-Set</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
          Ausgewogene Trainingspläne für die Pre-Season (Vorbereitung), reguläre Pflichtspielwochen und Englische Wochen.
        </p>
      </div>

      <DownloadBtn 
        file="training/xBurzelx_Trainingsplaene.zip" 
        label=".zip Paket herunterladen" 
        icon="📥"
      />
    </div>
  </div>

  <!-- MEDIA & CONFIGS SECTION -->
  <h3 style="color: var(--primary-color); border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
    📦 Medienpakete & Configs (.lnc)
  </h3>

  <div class="card-grid">
    <!-- MEDIA PACK -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <h3 style="color: var(--highlight-color); margin: 0 0 0.4rem 0;">🎨 xBurzelx Medienpaket</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
          Pressevertreter, sächsische Lokalzeitungen und Journalisten-IDs.
        </p>
      </div>

      <DownloadBtn 
        file="configs/Medienpaket.zip" 
        label=".zip Paket herunterladen" 
        icon="📥"
      />
    </div>

<!-- REAL NAME FIX -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <h3 style="color: var(--highlight-color); margin: 0 0 0.4rem 0;">📝 xBurzelx Real Name Fix (.lnc)</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
          Korrigierte Vereins-, Stadion- und Kurznamen.
        </p>
      </div>

      <DownloadBtn 
        file="configs/xBurzelxRealNameFix.lnc" 
        label=".lnc Datei herunterladen" 
        icon="📥"
      />
    </div>
  </div>

</BaseLayout>