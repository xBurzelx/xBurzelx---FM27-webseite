---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="FM27 Hub | Community & Ressourcen">
  
  <h2 class="section-title">🔗 Community & Ressourcen</h2>
  <p style="text-align: center; color: var(--text-secondary); margin-top: -1.5rem; margin-bottom: 2.5rem;">
    Die besten Anlaufstellen für Guides, Grafiken, Datenbanken und den Austausch in der FM-Community.
  </p>

  <!-- OFFIZIELL & ENTWICKLER -->
  <h3 style="color: var(--primary-color); border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
    🎮 Offizielle Seiten & Entwickler
  </h3>

  <div class="card-grid" style="margin-bottom: 3rem;">
    <!-- OFFIZIELLE FM SEITE -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <h3 style="color: var(--highlight-color); margin: 0 0 0.4rem 0;">⚽ Offizielle FM Website</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
          Die offizielle Football Manager Website mit News, Blogs, Feature-Ankündigungen und Patchnotes.
        </p>
      </div>
      <a href="https://www.footballmanager.com/de" target="_blank" rel="noopener noreferrer" class="btn-primary" style="text-align: center;">
        🌐 FootballManager.com ↗
      </a>
    </div>

    <!-- SI COMMUNITY FORUM -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <h3 style="color: var(--highlight-color); margin: 0 0 0.4rem 0;">🛡️ SI Community Forum</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
          Offizielles Entwicklerforum von Sports Interactive für Bug-Reports, Taktik-Diskussionen und Support.
        </p>
      </div>
      <a href="https://community.sigames.com/" target="_blank" rel="noopener noreferrer" class="btn-primary" style="text-align: center;">
        🌐 SI Forum ↗
      </a>
    </div>
  </div>

  <!-- DEUTSCHE COMMUNITY & PORTALE -->
  <h3 style="color: var(--primary-color); border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
    🇩🇪 Deutsche Community & Blogs
  </h3>

  <div class="card-grid" style="margin-bottom: 3rem;">
    <!-- FM ZWEIERKETTE -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <h3 style="color: var(--highlight-color); margin: 0 0 0.4rem 0;">⚽ FMZweierkette</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
          Starke deutsche Guides, Taktik-Analysen, Blogbeiträge und eine aktive FM-Community.
        </p>
      </div>
      <a href="https://fm.zweierkette.de/" target="_blank" rel="noopener noreferrer" class="btn-primary" style="text-align: center;">
        🌐 Website besuchen ↗
      </a>
    </div>

    <!-- MEISTERTRAINERFORUM -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <h3 style="color: var(--highlight-color); margin: 0 0 0.4rem 0;">💬 Meistertrainerforum</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
          Das traditionsreiche deutsche Forum für Taktikdiskussionen, Savegames und Support.
        </p>
      </div>
      <a href="https://www.meistertrainerforum.de/" target="_blank" rel="noopener noreferrer" class="btn-primary" style="text-align: center;">
        🌐 Zum Forum ↗
      </a>
    </div>
  </div>

  <!-- GRAFIKEN & LOGOS -->
  <h3 style="color: var(--primary-color); border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
    🎨 Grafiken, Logos & Facepacks
  </h3>

  <div class="card-grid" style="margin-bottom: 3rem;">
    <!-- SORTITOUTSI -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <h3 style="color: var(--highlight-color); margin: 0 0 0.4rem 0;">🖼️ Sortitoutsi</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
          Riesige Plattform für Cut-Out Facepacks, Logos, 3D-Kits, Daten-Updates und Files.
        </p>
      </div>
      <a href="https://sortitoutsi.net" target="_blank" rel="noopener noreferrer" class="btn-primary" style="text-align: center; background-color: var(--accent-color);">
        🌐 Sortitoutsi besuchen ↗
      </a>
    </div>

    <!-- SORTITOUTSI GRAFIK-SUCHE (GEHEIMTIPP) -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <span style="background: var(--accent-color); color: #fff; font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 4px; text-transform: uppercase;">
          💡 Geheimtipp
        </span>
        <h3 style="color: var(--highlight-color); margin: 0.5rem 0 0.4rem 0;">🔍 Sortitoutsi Graphics Search</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
          Direkte Bild- & ID-Suche für Facepack-Submissions. Perfekt, um gezielt einzelne fehlende Personenbilder zu finden.
        </p>
      </div>
      <a href="https://sortitoutsi.net/graphics/submissions/1/search" target="_blank" rel="noopener noreferrer" class="btn-primary" style="text-align: center; background-color: var(--accent-color);">
        🌐 Grafik-Suche öffnen ↗
      </a>
    </div>

    <!-- FM GRAPHICS -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <h3 style="color: var(--highlight-color); margin: 0 0 0.4rem 0;">👕 Football Manager Graphics</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
          Spezialisierte Anlaufstelle für hochwertige Trikot-Packs (3D Kits), Custom Logos, Skins und visuelle Upgrades.
        </p>
      </div>
      <a href="https://footballmanagergraphics.com/" target="_blank" rel="noopener noreferrer" class="btn-primary" style="text-align: center; background-color: var(--accent-color);">
        🌐 FM Graphics besuchen ↗
      </a>
    </div>
  </div>

  <!-- SCOUTING, TOOLS & TAKTIK-TESTS -->
  <h3 style="color: var(--primary-color); border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
    📊 Datenbanken, Tools & Taktik-Testing
  </h3>

  <div class="card-grid">
    <!-- FM SCOUT -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <h3 style="color: var(--highlight-color); margin: 0 0 0.4rem 0;">🔍 FM Scout</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
          Riesige Datenbank für Wonderkids, Custom Skins, Shortlists, Genie Scout und Taktik-Downloads.
        </p>
      </div>
      <a href="https://www.fmscout.com" target="_blank" rel="noopener noreferrer" class="btn-primary" style="text-align: center;">
        🌐 FM Scout besuchen ↗
      </a>
    </div>

    <!-- FM ARENA -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <span style="background: var(--primary-color); color: #fff; font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 4px; text-transform: uppercase;">
          ⚡ Simulation
        </span>
        <h3 style="color: var(--highlight-color); margin: 0.5rem 0 0.4rem 0;">⚡ FM Arena</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
          Automatisierte Taktik-Tests über tausende simulierte Spiele zur Messung der realen Match-Engine-Performance.
        </p>
      </div>
      <a href="https://fm-arena.com/" target="_blank" rel="noopener noreferrer" class="btn-primary" style="text-align: center;">
        🌐 FM Arena besuchen ↗
      </a>
    </div>
  </div>

</BaseLayout>