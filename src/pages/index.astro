---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="FM27 Hub | Startseite">
  
  <!-- Banner-Bereich (neues Banner / Grafik rein) -->
  <div class="hero-banner" style="background: #111; padding: 4rem 2rem; text-align: center;">
    <h2 style="color: var(--gold); margin: 0; font-size: 2.5rem;">Saison 1 meiner Trainerstory (2026/27)</h2>
    <p style="color: var(--text-muted);">kommt noch &bull; kommt noch</p>
  </div>

  <h2 class="section-title">Die Reise beginnt</h2>

  <div class="card-grid">
    <div class="card">
      <h3>📖 Neue Trainerstory</h3>
      <p>kommt noch</p>
    </div>
    <div class="card">
      <h3>Erfolge</h3>
      <p>kommt noch</p>
    </div>
    <div class="card">
      <h3>🎨 alles was ich zum download habe </h3>
      <p>Medienpaket, taktiken, Real-Name-Fixes (`.lnc`) training usw.</p>
    </div>
  </div>

  

</BaseLayout>