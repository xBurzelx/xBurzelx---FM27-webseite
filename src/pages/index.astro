---
import BaseLayout from '../layouts/BaseLayout.astro';

// Deine aktuellen Karriere-Stats
const stats = {
  spiele: 0,
  siege: 0,
  remis: 0,
  niederlagen: 0,
  tore: 0,
};

// Automatische Berechnung der Siegquote
const winRate = stats.spiele > 0 
  ? Math.round((stats.siege / stats.spiele) * 100) 
  : 0;
---

<BaseLayout title="FM27 Hub | Startseite">
  
  <div style="max-width: 1100px; margin: 0 auto; padding: 0 1rem;">

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <div style="background: #18181b; border: 1px solid #27272a; border-radius: 12px; padding: 1.5rem; margin: 1.5rem 0; box-shadow: 0 10px 25px rgba(0,0,0,0.5); text-align: center;">
      <div style="margin-bottom: 1.25rem;">
        <h2 style="color: #e5c158; font-size: 1.5rem; font-weight: 700; margin: 0 0 0.35rem 0; display: flex; align-items: center; justify-content: center; gap: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em;">
          <span>📍</span> Meine Karriere-Stationen
        </h2>
        <p style="color: #a1a1aa; font-size: 0.875rem; margin: 0;">
          Interaktive Übersicht aller Vereinsstationen im FM27
        </p>
      </div>

      <div id="map" style="height: 400px; width: 100%; min-height: 400px; border-radius: 8px; border: 1px solid #27272a; position: relative; z-index: 0;"></div>
    </div>

    <div style="background: #18181b; border: 1px solid #27272a; border-radius: 12px; padding: 1.5rem; margin: 1.5rem 0; box-shadow: 0 10px 25px rgba(0,0,0,0.5); text-align: center;">
      <div style="margin-bottom: 1.25rem;">
        <h2 style="color: #e5c158; font-size: 1.5rem; font-weight: 700; margin: 0 0 0.35rem 0; display: flex; align-items: center; justify-content: center; gap: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em;">
          <span>📊</span> Karriere-Bilanz
        </h2>
        <p style="color: #a1a1aa; font-size: 0.875rem; margin: 0;">
          Gesamtstatistik aller absolvierten Pflichtspiele
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem;">
        
        <div style="background: #09090b; border: 1px solid #27272a; border-radius: 8px; padding: 0.75rem; text-align: center;">
          <span style="display: block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #a1a1aa; font-weight: 600; margin-bottom: 0.25rem;">Spiele</span>
          <span style="font-size: 1.5rem; font-weight: 900; color: #ffffff;">{stats.spiele}</span>
        </div>

        <div style="background: #09090b; border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px; padding: 0.75rem; text-align: center;">
          <span style="display: block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #34d399; font-weight: 600; margin-bottom: 0.25rem;">Siege</span>
          <span style="font-size: 1.5rem; font-weight: 900; color: #34d399;">{stats.siege}</span>
        </div>

        <div style="background: #09090b; border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 8px; padding: 0.75rem; text-align: center;">
          <span style="display: block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #fbbf24; font-weight: 600; margin-bottom: 0.25rem;">Remis</span>
          <span style="font-size: 1.5rem; font-weight: 900; color: #fbbf24;">{stats.remis}</span>
        </div>

        <div style="background: #09090b; border: 1px solid rgba(244, 63, 94, 0.3); border-radius: 8px; padding: 0.75rem; text-align: center;">
          <span style="display: block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #fb7185; font-weight: 600; margin-bottom: 0.25rem;">Niederlagen</span>
          <span style="font-size: 1.5rem; font-weight: 900; color: #fb7185;">{stats.niederlagen}</span>
        </div>

        <div style="background: #09090b; border: 1px solid #27272a; border-radius: 8px; padding: 0.75rem; text-align: center;">
          <span style="display: block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #a1a1aa; font-weight: 600; margin-bottom: 0.25rem;">Tore</span>
          <span style="font-size: 1.5rem; font-weight: 900; color: #ffffff;">{stats.tore}</span>
        </div>

        <div style="background: #09090b; border: 1px solid rgba(229, 193, 88, 0.4); border-radius: 8px; padding: 0.75rem; text-align: center;">
          <span style="display: block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #e5c158; font-weight: 600; margin-bottom: 0.25rem;">Siegquote</span>
          <span style="font-size: 1.5rem; font-weight: 900; color: #e5c158;">{winRate}%</span>
        </div>

      </div>
    </div>

    <div style="background: #18181b; border: 1px solid #27272a; border-radius: 12px; padding: 1.5rem; margin: 1.5rem 0; box-shadow: 0 10px 25px rgba(0,0,0,0.5); text-align: center;">
      <div style="margin-bottom: 1.25rem;">
        <h2 style="color: #e5c158; font-size: 1.5rem; font-weight: 700; margin: 0 0 0.35rem 0; display: flex; align-items: center; justify-content: center; gap: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em;">
          <span>🏆</span> Trophäenschrank
        </h2>
        <p style="color: #a1a1aa; font-size: 0.875rem; margin: 0;">
          Alle errungenen Titel und Meilensteine deiner Manager-Karriere
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
        
        <div style="background: #09090b; border: 1px solid rgba(229, 193, 88, 0.4); border-radius: 12px; padding: 1rem; display: flex; align-items: center; gap: 1rem; text-align: left;">
          <div style="font-size: 1.8rem; padding: 0.6rem; background: rgba(229, 193, 88, 0.1); border-radius: 8px; border: 1px solid rgba(229, 193, 88, 0.2); display: flex; align-items: center; justify-content: center; width: 50px; height: 50px; shrink: 0;">
            🏆
          </div>
          <div>
            <h3 style="font-size: 1rem; font-weight: 700; color: #e5c158; margin: 0; line-height: 1.2;">Indian Super League</h3>
            <p style="font-size: 0.75rem; color: #a1a1aa; margin: 0.25rem 0 0.5rem 0;">Saison 2026/27</p>
            <span style="font-size: 0.7rem; font-weight: 600; background: rgba(229, 193, 88, 0.2); color: #e5c158; padding: 0.15rem 0.6rem; border-radius: 20px; border: 1px solid rgba(229, 193, 88, 0.3); display: inline-block;">
              Meister
            </span>
          </div>
        </div>

        <div style="background: #09090b; border: 1px solid #27272a; border-radius: 12px; padding: 1rem; display: flex; align-items: center; gap: 1rem; text-align: left; opacity: 0.45; filter: grayscale(100%);">
          <div style="font-size: 1.8rem; padding: 0.6rem; background: rgba(255, 255, 255, 0.05); border-radius: 8px; border: 1px solid #3f3f46; display: flex; align-items: center; justify-content: center; width: 50px; height: 50px; shrink: 0;">
            🔒
          </div>
          <div>
            <h3 style="font-size: 1rem; font-weight: 700; color: #a1a1aa; margin: 0; line-height: 1.2;">Nationaler Pokal</h3>
            <p style="font-size: 0.75rem; color: #71717a; margin: 0.25rem 0 0.5rem 0;">Ausstehend</p>
            <span style="font-size: 0.7rem; font-weight: 600; background: #27272a; color: #71717a; padding: 0.15rem 0.6rem; border-radius: 20px; border: 1px solid #3f3f46; display: inline-block;">
              Gesperrt
            </span>
          </div>
        </div>

        <div style="background: #09090b; border: 1px solid #27272a; border-radius: 12px; padding: 1rem; display: flex; align-items: center; gap: 1rem; text-align: left; opacity: 0.45; filter: grayscale(100%);">
          <div style="font-size: 1.8rem; padding: 0.6rem; background: rgba(255, 255, 255, 0.05); border-radius: 8px; border: 1px solid #3f3f46; display: flex; align-items: center; justify-content: center; width: 50px; height: 50px; shrink: 0;">
            🔒
          </div>
          <div>
            <h3 style="font-size: 1rem; font-weight: 700; color: #a1a1aa; margin: 0; line-height: 1.2;">Continental Champions League</h3>
            <p style="font-size: 0.75rem; color: #71717a; margin: 0.25rem 0 0.5rem 0;">Ausstehend</p>
            <span style="font-size: 0.7rem; font-weight: 600; background: #27272a; color: #71717a; padding: 0.15rem 0.6rem; border-radius: 20px; border: 1px solid #3f3f46; display: inline-block;">
              Gesperrt
            </span>
          </div>
        </div>

      </div>
    </div>

    <div style="background: #18181b; border: 1px solid #27272a; border-radius: 12px; padding: 1.5rem; margin: 1.5rem 0; box-shadow: 0 10px 25px rgba(0,0,0,0.5); text-align: center;">
      <div>
        <h2 style="color: #e5c158; font-size: 1.5rem; font-weight: 700; margin: 0 0 0.35rem 0; display: flex; align-items: center; justify-content: center; gap: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em;">
          <span>🎨</span> Downloads & Files
        </h2>
        <p style="color: #a1a1aa; font-size: 0.875rem; margin: 0;">
          Medienpaket, Taktiken, Real-Name-Fixes (`.lnc`), Trainingspläne uvm.
        </p>
      </div>
    </div>

  </div>

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline>
    function renderMap() {
      const mapContainer = document.getElementById('map');
      if (!mapContainer || typeof L === 'undefined' || mapContainer._leaflet_id) return;

      const map = L.map('map', { scrollWheelZoom: false }).setView([20.5937, 78.9629], 5);

      L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
        attribution: 'Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ',
        maxZoom: 16
      }).addTo(map);

      function createFlagIcon(countryCode) {
        const flagUrl = `https://flagcdn.com/w40/${countryCode.toLowerCase()}.png`;
        return L.divIcon({
          className: 'custom-flag-pin',
          html: `<img src="${flagUrl}" style="width: 32px; height: 22px; border-radius: 3px; box-shadow: 0 3px 8px rgba(0,0,0,0.8); border: 1px solid #52525b; object-fit: cover;" />`,
          iconSize: [32, 22],
          iconAnchor: [16, 11],
          popupAnchor: [0, -12]
        });
      }

      const stationen = [
        {
          name: "Zielgebiet: Indien",
          country: "in",
          lat: 20.5937,
          lng: 78.9629,
          status: "Auf Vereinssuche",
          saison: "Start 2026/27"
        }
      ];

      stationen.forEach(st => {
        const flagPin = createFlagIcon(st.country);
        L.marker([st.lat, st.lng], { icon: flagPin })
          .addTo(map)
          .bindPopup(`
            <div style="color: #111; font-family: sans-serif; text-align: center; min-width: 140px;">
              <strong style="font-size: 1.1em; display: block;">${st.name}</strong>
              <span style="color: #b45309; font-weight: bold; display: block; margin: 3px 0;">${st.status}</span>
              <small style="color: #555;"><b>Saison:</b> ${st.saison}</small>
            </div>
          `);
      });

      const routePoints = stationen.map(st => [st.lat, st.lng]);
      if (routePoints.length > 1) {
        L.polyline(routePoints, {
          color: '#e5c158',
          weight: 3,
          opacity: 0.8,
          dashArray: '8, 8',
          lineJoin: 'round'
        }).addTo(map);
      }

      setTimeout(() => { map.invalidateSize(); }, 200);
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      renderMap();
    } else {
      document.addEventListener('DOMContentLoaded', renderMap);
    }
    document.addEventListener('astro:page-load', renderMap);
  </script>

</BaseLayout>