---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="FM27 Hub | Startseite">
  
  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <!-- Weltkarte / Karriere-Stationen -->
  <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6 text-center my-6">
    <h2 class="text-2xl font-bold text-[#e5c158] mb-1">Meine Karriere-Stationen</h2>
    <p class="text-zinc-400 text-sm mb-4">Interaktive Übersicht aller Vereinsstationen im FM27</p>

    <!-- Karten-Container -->
    <div id="map" style="height: 400px; width: 100%; min-height: 400px;" class="rounded-lg border border-zinc-800 relative z-0"></div>
  </div>

  <!-- Leaflet JS -->
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script is:inline>
    function renderMap() {
      const mapContainer = document.getElementById('map');
      if (!mapContainer || typeof L === 'undefined') return;
      
      // Verhindert doppeltes Initialisieren
      if (mapContainer._leaflet_id) return;

      const map = L.map('map', {
        scrollWheelZoom: false
      }).setView([20.5937, 78.9629], 5);

      L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
        attribution: 'Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ',
        maxZoom: 16
      }).addTo(map);

      function createFlagIcon(countryCode) {
        // Verwendet kostenlose ISO-Flaggen (z. B. 'in' für Indien, 'sn' für Senegal, 'br' für Brasilien)
        const flagUrl = `https://flagcdn.com/w40/${countryCode.toLowerCase()}.png`;
        
        return L.divIcon({
          className: 'custom-flag-pin',
          html: `<img src="${flagUrl}" style="width: 32px; height: 22px; border-radius: 3px; box-shadow: 0 3px 8px rgba(0,0,0,0.8); border: 1px solid #52525b; object-fit: cover;" />`,
          iconSize: [32, 22],
          iconAnchor: [16, 11],
          popupAnchor: [0, -12]
        });
      }

      // In deinem stationen-Array einfach den ISO-Ländercode (country) mitgeben:
      const stationen = [
        {
          name: "Zielgebiet: Indien",
          country: "in", // ISO-Code für Indien
          lat: 20.5937,
          lng: 78.9629,
          status: "Auf Vereinssuche",
          saison: "Start 2026/27"
        }
      ];

      stationen.forEach(st => {
        const flagPin = createFlagIcon(st.country);
        
        L.marker([st.lat, st.lng], { icon: flagPin })
          .addTo(map)
          .bindPopup(`<b>${st.name}</b><br>${st.status}`);
      });

      stationen.forEach(st => {
        L.marker([st.lat, st.lng], { icon: goldPin })
          .addTo(map)
          .bindPopup(`
            <div style="color: #111; font-family: sans-serif;">
              <strong style="font-size: 1.1em;">${st.name}</strong><br>
              <span style="color: #4169e1; font-weight: bold;">${st.status}</span><br>
              <small><b>Saison:</b> ${st.saison}</small>
            </div>
          `);
      });

      setTimeout(() => { map.invalidateSize(); }, 200);
    }

    // Garantiert die Ausführung in Astro (egal ob DOM schon geladen ist oder nicht)
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      renderMap();
    } else {
      document.addEventListener('DOMContentLoaded', renderMap);
    }
    document.addEventListener('astro:page-load', renderMap);
  </script>

  <h2 class="section-title">Die Reise beginnt</h2>

  <div class="card-grid">
    <div class="card">
      <h3>📖 Neue Trainerstory</h3>
      <p>kommt noch</p>
    </div>
    <div class="card">
      <h3>Erfolge</h3>
      <p>kommt noch</p>
    </div>
    <div class="card">
      <h3>🎨 alles was ich zum download habe </h3>
      <p>Medienpaket, taktiken, Real-Name-Fixes (`.lnc`) training usw.</p>
    </div>
  </div>

</BaseLayout>